[access]
	inheritFrom = chromium
[submit]
	action = inherit
[label "Commit-Queue"]
	value = 0 Not ready
	value = +1 Dry run
	value = +2 Commit
	defaultValue = 0
	function = NoBlock
	copyCondition = changekind:NO_CHANGE
[access "refs/*"]
	owner = group mdb/chrome-git-admins
	label-Auto-Submit = +0..+1 group Change Owner
	label-Auto-Submit = +0..+1 group project-webpagereplay-committers
  label-Commit-Queue = +0..+2 group Logged-in Public Users
  labelAs-Commit-Queue = +0..+2 group catapult-scoped@luci-project-accounts.iam.gserviceaccount.com
  labelAs-Commit-Queue = group Logged-in Public Users
	label-Code-Review = -1..+1 group project-webpagereplay-committers
	submit = group project-webpagereplay-committers
[access "refs/for/*"]
	create = group project-webpagereplay-committers
	push = group project-webpagereplay-committers
