[access]
	inheritFrom = chromium
[submit]
	action = inherit
[label "Commit-Queue"]
	value = 0 Not ready
	value = +1 Dry run
	value = +2 Commit
	defaultValue = 0
	function = NoBlock
	copyCondition = changekind:NO_CHANGE
[access "refs/*"]
	owner = group mdb/chrome-git-admins
	label-Auto-Submit = +0..+1 group Change Owner
	label-Auto-Submit = +0..+1 group cria/project-catapult-committers
	label-Code-Review = -1..+1 group cria/project-catapult-committers
	label-Commit-Queue = +0..+2 group cria/project-catapult-committers
	labelAs-Commit-Queue = +0..+2 group catapult-scoped@luci-project-accounts.iam.gserviceaccount.com
	labelAs-Commit-Queue = group cria/project-catapult-committers
	submit = group cria/project-catapult-committers
[access "refs/for/*"]
	create = group cria/project-catapult-committers
	push = group cria/project-catapult-committers
