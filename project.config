[access]
	inheritFrom = chromium
[submit]
	action = inherit
[access "refs/*"]
	owner = group mdb/chrome-git-admins
	label-Auto-Submit = +0..+1 group Change Owner
	label-Auto-Submit = +0..+1 group cria/project-speedometer-admins
	label-Auto-Submit = +0..+1 group cria/project-speedometer-committers
	label-Auto-Submit = +0..+1 group project-webpagereplay-committers
	label-Code-Review = -1..+1 group cria/project-speedometer-committers
	label-Code-Review = -1..+1 group project-webpagereplay-committers
	submit = group cria/project-speedometer-committers
	submit = group project-webpagereplay-committers
[access "refs/for/*"]
	create = group project-webpagereplay-committers
	push = group project-webpagereplay-committers
